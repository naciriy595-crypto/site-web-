DATABASE_URL="postgresql://user:password@localhost:5432/clifstone"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@clifstone.co"
ADMIN_PASSWORD="ChangeMe123!"
WHATSAPP_ORDER_NUMBER="212640848752"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: only needed if you switch the WhatsApp notification from the
# default wa.me deep link to the fully-automatic WhatsApp Cloud API.
# META_WHATSAPP_TOKEN=""
# META_WHATSAPP_PHONE_NUMBER_ID=""

# Ameex delivery API — an order automatically tries to create a shipment
# through Ameex right after it's saved. AMEEX_API_ID and AMEEX_API_KEY alone
# are NOT enough: AMEEX_API_BASE_URL (their API host) is still required, and
# the exact endpoint/field names in src/lib/delivery/ameex.ts are a
# best-guess until Ameex's real API docs are available. Until all of
# AMEEX_API_BASE_URL / AMEEX_API_ID / AMEEX_API_KEY are set, the auto-call is
# skipped, the order still saves normally, and the admin gets a WhatsApp
# alert instead of a silent failure.
AMEEX_API_ID=""
AMEEX_API_KEY=""
# AMEEX_API_BASE_URL="https://api.ameex.example"
# Optional: lets the site link to Ameex's own tracking page for a shipment.
# {id} is replaced with the tracking number.
# AMEEX_TRACKING_URL_TEMPLATE="https://ameex.ma/track/{id}"
