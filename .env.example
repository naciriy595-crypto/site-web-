# Optional: only needed if you switch the WhatsApp notification from the
# default wa.me deep link to the fully-automatic WhatsApp Cloud API.
# META_WHATSAPP_TOKEN=""
# META_WHATSAPP_PHONE_NUMBER_ID=""

# Ameex delivery API — an order automatically tries to create a shipment
# (a "parcel") through Ameex right after it's saved, via their real
# Add Parcel endpoint (https://api.ameex.app/customer/Delivery/Parcels/Action/Type/Add).
# All three of AMEEX_API_ID, AMEEX_API_KEY and AMEEX_BUSINESS_ID are required
# for the auto-call to run; until then, the order still saves normally and
# the admin gets a WhatsApp alert instead of a silent failure.
# AMEEX_BUSINESS_ID is your business/store id inside Ameex — confirm this in
# your Ameex dashboard, it is NOT the same as your API ID.
AMEEX_API_ID=""
AMEEX_API_KEY=""
AMEEX_BUSINESS_ID=""
# Optional: lets the site link to Ameex's own tracking page for a shipment.
# {id} is replaced with the tracking number.
# AMEEX_TRACKING_URL_TEMPLATE="https://ameex.ma/track/{id}"
