# Ameex delivery API — set these once you have real credentials/docs from
# Ameex to enable the "Envoyer à Ameex" button in the admin order page.
# Until both are set, that button shows a clear "not configured" message and
# admins can use CSV export or the manual tracking-number field instead.
# AMEEX_API_BASE_URL="https://api.ameex.example"
# AMEEX_API_KEY=""
# Optional: lets the site link to Ameex's own tracking page for a shipment.
# {id} is replaced with the tracking number.
# AMEEX_TRACKING_URL_TEMPLATE="https://ameex.ma/track/{id}"
